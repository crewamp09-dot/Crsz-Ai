            try {
                let res = await fetch('/api/post-comment', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ project_id: projectId, comment: commentText })
                });
                if(res.ok) {
                    inputField.value = '';
                    loadComments(projectId);
                }
            } catch (err) {
                console.error("Yorum hatası:", err);
